# ─────────────────────────────────────────────────────────────────────────────
# AllerCheck - Exemplo de Configuração (.env)
# ─────────────────────────────────────────────────────────────────────────────
# IMPORTANTE: Copie este arquivo para .env e preencha com seus valores reais.
# Nunca commite o .env com chaves de API reais.

# ─── API Keys ─────────────────────────────────────────────────────────────────
# Chave de API OpenAI para geração de respostas (GPT-4, GPT-4o-mini)
OPENAI_API_KEY=sk-proj-...

# Chave de API Google Gemini para geração de respostas alternativa
GEMINI_API_KEY=AIzaSy...

# Chave de API Anthropic (Claude) para avaliação RAGAS
ANTHROPIC_API_KEY=sk-ant-...

# Chave de API Pinecone para vector database (embeddings)
PINECONE_API_KEY=pcsk_...

# ─── LLM Configuration ────────────────────────────────────────────────────────
# Provedor para REESCRITA de query (query rewrite, safety gate, reranker)
# Valores permitidos: "openai" ou "gemini"
REWRITE_PROVIDER=gemini

# Modelo específico para reescrita (ex: gpt-4o-mini, gemini-2.5-flash-lite)
REWRITE_MODEL=gemini-2.5-flash-lite

# Provedor para GERAÇÃO da resposta final
# Valores permitidos: "openai" ou "gemini"
ANSWER_PROVIDER=gemini

# Modelo específico para geração (ex: gpt-4o, gemini-2.5-flash-lite)
ANSWER_MODEL=gemini-2.5-flash-lite

# Provedor LLM local (Ollama) — alternativa sem custos
# Valores permitidos: "ollama"
SLM_PROVIDER=ollama

# URL base do Ollama (rodando em localhost ou Docker)
SLM_BASE_URL=http://localhost:11434

# Modelo Ollama a usar (ex: mistral, llama2)
SLM_MODEL=mistral

# ─── Temperaturas [OBRIGATÓRIAS] ──────────────────────────────────────────────
# Controla a criatividade/determinismo dos modelos:
#   0.0  = determinístico (ideal para avaliação e consistency)
#   0.1  = quase determinístico (ideal para reescrita de queries)
#   0.2  = levemente criativo (ideal para geração de respostas clínicas)
#   1.0  = muito criativo (NÃO recomendado para contexto clínico)
#
# AVISO: Se estas variáveis não forem definidas, a aplicação falha com KeyError!
# Não existe fallback automático.

# Temperatura para REESCRITA de query (query rewrite, safety gate, reranker)
REWRITE_TEMPERATURE=0.1

# Temperatura para GERAÇÃO da resposta final
ANSWER_TEMPERATURE=0.2

# Temperatura para AVALIADORES RAGAS (determinístico para consistência)
EVALUATOR_TEMPERATURE=0

# ─── Benchmark Ollama [OBRIGATÓRIAS: MODELS, TIMEOUT, TEMPERATURE] ────────────
# Modelos a testar no benchmark (separados por vírgula) [OBRIGATÓRIO]
BENCHMARK_MODELS=qwen2.5:7b,mistral:latest,neural-chat:latest,phi:latest,qwen3.5:4b

# Timeout máximo por modelo no benchmark (em segundos) [OBRIGATÓRIO]
BENCHMARK_TIMEOUT=240

# Temperatura para o benchmark [OBRIGATÓRIO]
# Se não definida, a aplicação falha com KeyError!
BENCHMARK_TEMPERATURE=0.2

# Pergunta padrão para o benchmark (OPCIONAL, com fallback no código)
# BENCHMARK_QUESTION=Qual é o medicamento paracetamol e para que serve?

# Contexto padrão para o benchmark (OPCIONAL, com fallback no código)
# BENCHMARK_CONTEXT=O paracetamol é um medicamento analgésico e antipirético...

# ─── Vector Database ──────────────────────────────────────────────────────────
# Nome do índice Pinecone onde os embeddings estão armazenados
INDEX_NAME=allercheck

# ─── Authentication ───────────────────────────────────────────────────────────
# ID de cliente Google OAuth 2.0 (obtido em console.cloud.google.com)
GOOGLE_CLIENT_ID=645905864300-...

# Algoritmo JWT para assinatura de tokens
JWT_ALGORITHM=HS256

# Tempo de expiração do token de acesso (em minutos)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Chave secreta para assinar JWTs (MUDE EM PRODUÇÃO!)
JWT_SECRET_KEY=change-this-secret-in-production

# ─── Frontend ─────────────────────────────────────────────────────────────────
# URL base da API FastAPI (visto do frontend)
# Localhost: http://localhost:8000
# Docker: http://api:8000
API_BASE_URL=http://localhost:8000

# ID de cliente Google OAuth 2.0 (mesmo que GOOGLE_CLIENT_ID, com prefixo Next.js)
# Usado durante o build do Next.js para disponibilizar em variáveis públicas
NEXT_PUBLIC_GOOGLE_CLIENT_ID=645905864300-...

# ─── Modelos para Avaliação RAGAS ────────────────────────────────────────────
# Modelo OpenAI/GPT para avaliação de qualidade
OPENAI_LLM_MODEL=gpt-4o-mini

# Modelo de embeddings OpenAI
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Modelo Gemini para avaliação
GEMINI_LLM_MODEL=gemini-2.5-flash-lite

# Modelo Claude/Anthropic para avaliação
CLAUDE_MODEL=claude-haiku-4-5-20251001

# ─── Chunking (Ingestão de Documentos) ─────────────────────────────────────────
# Tamanho de cada chunk de texto (em caracteres)
CHUNK_SIZE=550

# Sobreposição entre chunks (em caracteres) para manter contexto
CHUNK_OVERLAP=110

# ─── Retrieval (RAG) ───────────────────────────────────────────────────────────
# Número de chunks a recuperar no retrieval padrão
RETRIEVAL_K=8

# Score de similaridade mínimo para o retrieval
RETRIEVAL_SCORE_THRESHOLD=0.60

# Número de chunks para HyDE (Hypothetical Document Embeddings)
HYDE_K=4

# Score de similaridade mínimo para HyDE
HYDE_SCORE_THRESHOLD=0.62

# ─── Ingestion ────────────────────────────────────────────────────────────────
# Intervalo entre ciclos de ingestão de documentos (em segundos)
# Padrão: 7200 (2 horas)
INGEST_INTERVAL_SECONDS=7200

# Caminho para os documentos a ingerir
INGEST_SOURCE_PATH=./api/ingestion/data

# Forçar reextração dos documentos (ignorar cache)
INGEST_FORCE_EXTRACT=false

# Forçar recriação do índice Pinecone
INGEST_FORCE_RECREATE_INDEX=false

# ─── Processamento VigiMed ─────────────────────────────────────────────────────
# Configurações para processamento em batch de dados médicos (VigiMed API)

# Tamanho do batch para processamento
BATCH_SIZE=10

# Número máximo de tentativas em caso de falha
MAX_RETRIES=8

# Tempo máximo de espera para retry (segundos)
RETRY_MAX_SECONDS=120

# Timeout para cada requisição (segundos)
REQUEST_TIMEOUT_SECONDS=90

# Intervalo mínimo entre requisições (segundos)
MIN_REQUEST_INTERVAL_SECONDS=2.0

# Tamanho do sub-batch para API
API_SUB_BATCH_SIZE=5

# Tamanho mínimo/máximo do sub-batch (para scaling adaptativo)
API_SUB_BATCH_MIN_SIZE=1
API_SUB_BATCH_MAX_SIZE=5

# Habilitar scaling adaptativo de batches
ADAPTIVE_SUB_BATCH_ENABLED=1

# A cada quantas iterações fazer scale-up do batch
ADAPTIVE_SCALE_UP_EVERY=2

# Número máximo de linhas a processar (0 = sem limite)
MAX_ROWS_TO_PROCESS=0

# Limite de Tokens Por Minuto (TPM) para não exceder quota
TPM_LIMIT=30000

# Tokens máximos na resposta da IA
MAX_OUTPUT_TOKENS=320

# Número máximo de sentenças na resposta
MAX_OUTPUT_SENTENCES=6

# Número máximo de caracteres na resposta
MAX_OUTPUT_CHARS=2000

# Tokens máximos para um batch completo
BATCH_MAX_OUTPUT_TOKENS=700

# ─── Análise ASBAI (Alergia e Imunologia) ───────────────────────────────────────
# Número máximo de caracteres para análise ASBAI
ASBAI_MAX_CHARS=8000

# Modelo para análise de documentos longos
ASBAI_LONG_DOCUMENT_MODEL=gpt-4o
