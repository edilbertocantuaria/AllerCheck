#!/usr/bin/env python3
"""
LLM-as-Judge: roda localmente (não em container)
"""

import asyncio
import hashlib
import json
import os
import re
import sys
from pathlib import Path
from datetime import datetime, timezone, timedelta
from dotenv import load_dotenv

# Force UTF-8 on Windows
if sys.platform == "win32":
    import io
    sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding="utf-8")

# Load .env from project root
api_root = Path(__file__).resolve().parent.parent
project_root = api_root.parent
load_dotenv(project_root / ".env")

sys.path.insert(0, str(Path(__file__).resolve().parent))

from openai import AsyncOpenAI

import eval_config
from cost_guard import fatal_reason, preflight

from judge_analysis import (
    LETTERS,
    TIE_EPSILON,
    build_orders,
    compare_ragas_with_judges,
    consensus_from_votes,
    judge_status,
    pooled_consensus,
    same_letter_both_orders,
)

_BRT = timezone(timedelta(hours=-3))

JUDGE_TEMPERATURE = eval_config.judge_temperature()
JUDGE_MAX_TOKENS = eval_config.judge_max_tokens()
_JUDGE_MODELS = eval_config.judge_models()

JUDGES = {
    "gpt-4o-mini": {"provider": "openai", "model": _JUDGE_MODELS["gpt"], "temperature": JUDGE_TEMPERATURE},
    "gemini": {"provider": "gemini", "model": _JUDGE_MODELS["gemini"], "temperature": JUDGE_TEMPERATURE},
    "claude": {"provider": "anthropic", "model": _JUDGE_MODELS["claude"], "temperature": JUDGE_TEMPERATURE},
}

PROMPT_TEMPLATE_FILE = api_root / "app" / "prompts" / "templates" / "llm_judge_prompt.md"
PROMPT_TEMPLATE = PROMPT_TEMPLATE_FILE.read_text(encoding="utf-8")


async def _call_provider(prompt_content: str, judge_config: dict) -> str:
    provider = judge_config["provider"]

    if provider == "openai":
        client = AsyncOpenAI(api_key=os.getenv("OPENAI_API_KEY"))
        response = await client.chat.completions.create(
            model=judge_config["model"],
            messages=[{"role": "user", "content": prompt_content}],
            temperature=judge_config["temperature"],
        )
        return response.choices[0].message.content

    if provider == "gemini":
        import google.generativeai as genai

        genai.configure(api_key=os.getenv("GEMINI_API_KEY"))
        model = genai.GenerativeModel(judge_config["model"])
        response = await asyncio.to_thread(
            model.generate_content,
            prompt_content,
            generation_config={"temperature": judge_config["temperature"]},
        )
        return response.text

    if provider == "anthropic":
        from anthropic import Anthropic

        client = Anthropic(api_key=os.getenv("ANTHROPIC_API_KEY"))
        response = await asyncio.to_thread(
            client.messages.create,
            model=judge_config["model"],
            max_tokens=JUDGE_MAX_TOKENS,
            temperature=judge_config["temperature"],
            messages=[{"role": "user", "content": prompt_content}],
        )
        return response.content[0].text

    raise ValueError(f"provider desconhecido: {provider}")


_CHOICE_RE = re.compile(r'"choice"\s*:\s*"\s*([A-Za-z])\s*"')


def _parse_choice(text: str):
    """Lê a escolha do juiz. JSON malformado só é aceito se a letra de "choice" aparecer sem ambiguidade."""
    match = re.search(r'\{[^{}]*"choice"[^{}]*\}', text or "", re.DOTALL)
    json_error = None
    if match:
        try:
            parsed = json.loads(match.group())
        except json.JSONDecodeError as e:
            parsed, json_error = None, f"JSON inválido: {e}"
        if parsed is not None:
            choice = str(parsed.get("choice", "")).strip().upper()
            if choice not in LETTERS:
                return None, f"choice fora de A/B/C: {parsed.get('choice')!r}"
            parsed["choice"] = choice
            return parsed, None
    letters = {m.upper() for m in _CHOICE_RE.findall(text or "")}
    if len(letters) == 1 and next(iter(letters)) in LETTERS:
        return {"choice": next(iter(letters)), "reasoning": None, "parse_recovered": json_error or "choice extraído por regex"}, None
    return None, json_error or "JSON com 'choice' não encontrado"


async def judge_responses(question: str, responses: dict, judge_name: str, judge_config: dict) -> dict:
    """Envia as 3 respostas para um juiz. Falha de API ou de parse vira erro, nunca voto."""
    prompt_content = PROMPT_TEMPLATE.format(
        question=question,
        response_a=responses["A"],
        response_b=responses["B"],
        response_c=responses["C"],
    )

    base = {"judge": judge_name, "prompt_sent": prompt_content}

    try:
        text = await _call_provider(prompt_content, judge_config)
    except Exception as e:
        print(f"   ⚠️  {judge_name} falhou: {type(e).__name__}: {e}")
        full = f"{type(e).__name__}: {e}"
        return {**base, "choice": None, "error": full[:600], "fatal": fatal_reason(full), "raw_response": None}

    parsed, parse_error = _parse_choice(text)
    if parse_error:
        print(f"   ⚠️  {judge_name} resposta inválida: {parse_error}")
        return {**base, "choice": None, "error": parse_error, "raw_response": text}

    return {**base, "raw_response": text, "error": None, **parsed}


def _legacy_ragas_winner(item_com: dict, item_sem: dict) -> str:
    com = (item_com.get("results") or {}).get("gemini", {}).get("context_recall")
    sem = (item_sem.get("results") or {}).get("gemini", {}).get("context_recall")
    if com is None or sem is None:
        return "indisponivel"
    return "com_ontologia" if com > sem else "sem_ontologia" if sem > com else "empate"


async def main(selected_questions_file: str = None, ragas_output_file: str = None, seed: int = 42):
    if selected_questions_file:
        print(f"📋 Carregando questões selecionadas: {Path(selected_questions_file).name}")
        try:
            with open(selected_questions_file, encoding="utf-8") as f:
                selected_data = json.load(f)
                if isinstance(selected_data, dict) and "questions" in selected_data:
                    selected_questions = selected_data["questions"]
                else:
                    selected_questions = selected_data
            print(f"   ✅ {len(selected_questions)} questões carregadas\n")
        except Exception as e:
            print(f"   ❌ Erro: {e}")
            sys.exit(1)
    else:
        print("❌ selected_questions_file não foi fornecido!")
        sys.exit(1)

    if ragas_output_file:
        print(f"📊 Carregando RAGAS output: {Path(ragas_output_file).name}")
        try:
            with open(ragas_output_file, encoding="utf-8") as f:
                eval_data = json.load(f)
            print(f"   ✅ Carregado\n")
        except Exception as e:
            print(f"   ❌ Erro: {e}")
            sys.exit(1)
    else:
        print("❌ ragas_output_file não foi fornecido!")
        sys.exit(1)

    conditions = {c["name"]: c for c in eval_data["conditions"]}
    com_items_map = {}
    sem_items_map = {}
    for item in conditions["com_ontologia"]["items"]:
        if not item.get("errors") and item.get("question_id") is not None:
            com_items_map[item["question_id"]] = item
    for item in conditions["sem_ontologia"]["items"]:
        if not item.get("errors") and item.get("question_id") is not None:
            sem_items_map[item["question_id"]] = item

    print(f"✅ RAGAS items:")
    print(f"   COM: {len(com_items_map)} questões")
    print(f"   SEM: {len(sem_items_map)} questões\n")

    test_questions = []
    for q in selected_questions:
        q_id = q.get("question_id")
        if q_id in com_items_map and q_id in sem_items_map:
            test_questions.append({
                "question_id": q_id,
                "item_com": com_items_map[q_id],
                "item_sem": sem_items_map[q_id],
            })
        else:
            missing = [c for c, m in (("COM", com_items_map), ("SEM", sem_items_map)) if q_id not in m]
            print(f"⚠️  Q{q_id}: sem resultado RAGAS ({'/'.join(missing)})")

    print(f"🎯 Avaliando {len(test_questions)} questões sincronizadas\n")

    if not test_questions:
        print("❌ Nenhuma questão sincronizada entre selecionadas e RAGAS results")
        print(f"   IDs esperados: {[q.get('question_id') for q in selected_questions]}")
        sys.exit(1)

    llm_judge_results = []
    comparison_inputs = []
    comparison_inputs_pooled = []

    print("🔎 Checagem prévia dos juízes (1 chamada mínima por provedor)...")
    pre = await preflight([(cfg_name, model) for cfg_name, model in _JUDGE_MODELS.items()])
    for name, err in pre.items():
        print(f"   {'✅' if not err else '❌'} {name}" + (f": {err}" if err else ""))
    if any(pre.values()):
        print("❌ Checagem prévia falhou; nada foi julgado. Corrija chave/crédito e rode de novo.")
        sys.exit(1)

    aborted = None
    for pos, test_q in enumerate(test_questions, 1):
        q_id = test_q["question_id"]
        item_com = test_q["item_com"]
        item_sem = test_q["item_sem"]

        question = item_com.get("question", "")
        texts = {
            "ground_truth": item_com.get("ground_truth", ""),
            "com_ontologia": item_com.get("answer", ""),
            "sem_ontologia": item_sem.get("answer", ""),
        }

        print(f"🔬 QUESTÃO {pos}/{len(test_questions)} (Q{q_id}):")
        print(f"   {question[:80]}...")

        orders = build_orders(seed, q_id)
        judge_orders = []
        for order_num, mapping in enumerate(orders, 1):
            responses_dict = {letter: texts[source] for letter, source in mapping.items()}
            votes = await asyncio.gather(*[
                judge_responses(question, responses_dict, judge_name, judge_config)
                for judge_name, judge_config in JUDGES.items()
            ])
            fatal = next((v["fatal"] for v in votes if v.get("fatal")), None)
            if fatal:
                aborted = {"reason": fatal, "question_id": q_id, "order": order_num}
                break
            for vote in votes:
                vote["choice_source"] = mapping.get(vote["choice"]) if vote["choice"] else None
            judge_orders.append({"order": order_num, "mapping": mapping, "votes": votes})

        if aborted:
            print(f"❌ ABORTADO na Q{q_id}: {aborted['reason']}. Questão descartada (incompleta).")
            break

        judge_votes = {}
        valid_votes = {}
        for judge_name in JUDGES:
            sources = [
                next(v for v in order["votes"] if v["judge"] == judge_name)["choice_source"]
                for order in judge_orders
            ]
            status, source = judge_status(sources[0], sources[1])
            judge_votes[judge_name] = {
                "status": status,
                "choice_source": source,
                "order_1": sources[0],
                "order_2": sources[1],
            }
            if status == "valid":
                valid_votes[judge_name] = source

        consensus, strength = consensus_from_votes(valid_votes)
        pooled = pooled_consensus([
            vote["choice_source"] for order in judge_orders for vote in order["votes"]
        ])

        print(f"   VOTOS (2 ordens):")
        for judge_name, jv in judge_votes.items():
            print(f"     {judge_name:12} o1={jv['order_1']} o2={jv['order_2']} → {jv['status']}"
                  f"{'' if jv['status'] != 'valid' else ' (' + jv['choice_source'] + ')'}")
        print(f"   CONSENSO: {consensus} [{strength}] ({len(valid_votes)} votos válidos)")
        print(f"   AGRUPADO (6 votos): {pooled['consensus']} {pooled['counts']}\n")

        llm_judge_results.append({
            "question_id": q_id,
            "question": question,
            "responses": texts,
            "judge_orders": judge_orders,
            "judge_votes": judge_votes,
            "n_valid_votes": len(valid_votes),
            "consensus": consensus,
            "consensus_strength": strength,
            "pooled": pooled,
        })
        comparison_inputs_pooled.append({
            "question_id": q_id,
            "consensus": pooled["consensus"],
            "com_results": item_com.get("results") or {},
            "sem_results": item_sem.get("results") or {},
        })
        comparison_inputs.append({
            "question_id": q_id,
            "consensus": consensus,
            "com_results": item_com.get("results") or {},
            "sem_results": item_sem.get("results") or {},
        })

        legacy_winner = _legacy_ragas_winner(item_com, item_sem)
        llm_judge_results[-1]["legacy_ragas_winner"] = legacy_winner
        llm_judge_results[-1]["legacy_agreement"] = consensus == legacy_winner

    if not llm_judge_results:
        print("❌ Nenhuma questão concluída antes do abort; nada gravado.")
        sys.exit(2)

    per_question_cmp, ragas_vs_judges = compare_ragas_with_judges(comparison_inputs)
    per_question_cmp_pooled, ragas_vs_judges_pooled = compare_ragas_with_judges(comparison_inputs_pooled)
    for r in llm_judge_results:
        r["ragas_vs_judges"] = per_question_cmp[r["question_id"]]
        r["ragas_vs_judges_pooled"] = per_question_cmp_pooled[r["question_id"]]

    timestamp_iso = datetime.now(_BRT).isoformat()
    timestamp_file = datetime.now(_BRT).strftime("%Y%m%d_%H%M%S")

    consensus_scores = {
        source: sum(1 for r in llm_judge_results if r["consensus"] == source)
        for source in ("com_ontologia", "sem_ontologia", "ground_truth")
    }
    consensus_scores["sem_consenso"] = sum(1 for r in llm_judge_results if r["consensus"] is None)

    pooled_scores = {
        source: sum(1 for r in llm_judge_results if r["pooled"]["consensus"] == source)
        for source in ("com_ontologia", "sem_ontologia", "ground_truth")
    }
    pooled_scores["empate"] = sum(1 for r in llm_judge_results if r["pooled"]["consensus"] is None)

    judge_vote_quality = {}
    for judge_name in JUDGES:
        statuses = [r["judge_votes"][judge_name]["status"] for r in llm_judge_results]
        valid, inconsistent, error = (statuses.count(s) for s in ("valid", "inconsistent", "error"))
        judge_vote_quality[judge_name] = {
            "valid": valid,
            "inconsistent": inconsistent,
            "error": error,
            "same_letter_both_orders": sum(
                same_letter_both_orders(r["judge_orders"], judge_name) for r in llm_judge_results
            ),
            "order_inconsistency_rate": round(inconsistent / (valid + inconsistent), 4) if (valid + inconsistent) else None,
        }

    judge_config = {
        "seed": seed,
        "evaluations_per_question": 2,
        "order_policy": "ordem 1 sorteada com Random(f'{seed}-{question_id}'); ordem 2 = rotação de uma posição",
        "judges": {name: dict(cfg) for name, cfg in JUDGES.items()},
        "prompt_file": str(PROMPT_TEMPLATE_FILE.name),
        "prompt_sha256": hashlib.sha256(PROMPT_TEMPLATE.encode("utf-8")).hexdigest(),
        "consensus_rule": "só votos válidos (mesma condição nas 2 ordens); >=2 iguais = maioria, 3 = unânime, senão sem consenso",
        "pooled_rule": "sensibilidade: soma dos votos legíveis (juízes × ordens); pluralidade estrita, empate no topo = sem consenso",
        "tie_epsilon": TIE_EPSILON,
    }

    output = {
        "timestamp": timestamp_iso,
        "test_type": ("BASELINE DE RUÍDO (SEM geração 2 vs SEM geração 1) · " if eval_data.get("baseline") else "") + f"LLM-as-Judge ({len(test_questions)} questões sincronizadas)",
        "baseline": eval_data.get("baseline"),
        "judges": list(JUDGES.keys()),
        "judge_config": judge_config,
        "source_file": str(ragas_output_file),
        "ragas_evaluators": sorted(ragas_vs_judges.keys()),
        "aborted": aborted,
        "results": llm_judge_results,
        "summary": {
            "total_questions": len(llm_judge_results),
            "consensus_scores": consensus_scores,
            "consensus_strength_distribution": {
                s: sum(1 for r in llm_judge_results if r["consensus_strength"] == s)
                for s in ("unanimous", "majority", "none")
            },
            "judge_vote_quality": judge_vote_quality,
            "ragas_vs_judges": ragas_vs_judges,
            "pooled_consensus_scores": pooled_scores,
            "ragas_vs_judges_pooled": ragas_vs_judges_pooled,
            "legacy_agreements": sum(1 for r in llm_judge_results if r["legacy_agreement"]),
            "legacy_divergences": sum(1 for r in llm_judge_results if not r["legacy_agreement"]),
        },
    }

    output_dir = project_root / "api" / "tools" / "data" / "processed" / "llm_judge"
    output_dir.mkdir(parents=True, exist_ok=True)

    output_file = output_dir / f"llm_judge_{timestamp_file}.json"
    output_file.write_text(json.dumps(output, ensure_ascii=False, indent=2), encoding="utf-8")

    print(f"{'='*70}")
    print(f"✅ RESUMO: {len(llm_judge_results)} questões")
    print(f"   Consenso estrito: {consensus_scores}")
    print(f"   Consenso agrupado (sensibilidade): {pooled_scores}")
    print(f"   Arquivo: {output_file.name}")
    print(f"   Caminho: {output_file}")
    print(f"{'='*70}\n")
    if aborted:
        print(f"❌ Execução ABORTADA ({aborted['reason']}); resultado parcial: {len(llm_judge_results)} questões.")
        sys.exit(2)


if __name__ == "__main__":
    selected_questions_file = sys.argv[1] if len(sys.argv) > 1 else None
    ragas_output_file = sys.argv[2] if len(sys.argv) > 2 else None
    seed = int(sys.argv[3]) if len(sys.argv) > 3 else 42
    asyncio.run(main(selected_questions_file, ragas_output_file, seed))
